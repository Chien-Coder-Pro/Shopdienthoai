@model ProfileForm
@{
	ViewData["Title"] = "Hồ sơ của tôi"; var u = (Nguoidung)ViewBag.CurrentUser;
}
<div class="section-heading">
	<div>
		<span class="eyebrow">KHÔNG GIAN CỦA BẠN</span>
		<h1>
			Xin chào, @u.Ten<span class="text-green">.</span>
		</h1>
	</div>
	<a asp-action="Orders" class="btn btn-outline-success">Đơn hàng của tôi</a>
</div>
<div class="row g-4">
	<div class="col-lg-4">
		<div class="member-card">
			<span class="eyebrow">CHIENNGUYENSHOP MEMBER</span>
			<h2>@u.Ho @u.Ten</h2>
			<span class="member-tier">@u.MaHangNavigation.TenHang</span>
			<p>
				Ưu đãi theo hạng: <strong>@u.MaHangNavigation.PhanTramGiam%</strong>
			</p>
			<small>Hạng được shop xét duyệt theo chi tiêu hợp lệ. Ưu đãi được chốt khi tạo đơn.</small>
		</div>
		<div class="panel mt-3">
			<p>
				<strong>Email:</strong> @u.Email
			</p>
			<a asp-action="ChangePassword" class="btn btn-outline-success w-100">@(u.CoMatKhau ? "Đổi mật khẩu" : "Tạo mật khẩu đăng nhập")</a>@if(u.GoogleId==null){
			<form asp-action="Google" method="post" class="mt-3">
				<input name="link" type="hidden" value="true">
				<button class="btn-google w-100" disabled="@(!(ViewBag.GoogleEnabled is true))">Liên kết Google</button>
			</form>
			<small class="form-hint">Dùng tài khoản Google có cùng email.</small>
}else
{
				<p class="text-green mt-3 mb-0">✓ Đã liên kết Google</p>
			}
		</div>
	</div>
	<div class="col-lg-8">
		<div class="panel">
			<h3>Thông tin cá nhân</h3>
			<form asp-action="CustomerInfo" method="post">
				<div asp-validation-summary="All" class="text-danger">
				</div>
				<div class="row g-3">
					<div class="col-sm-6">
						<label asp-for="Ho">Họ và tên đệm</label>
						<input asp-for="Ho" class="form-control" autocomplete="family-name">
						<span asp-validation-for="Ho" class="text-danger">
						</span>
					</div>
					<div class="col-sm-6">
						<label asp-for="Ten">Tên</label>
						<input asp-for="Ten" class="form-control" autocomplete="given-name">
						<span asp-validation-for="Ten" class="text-danger">
						</span>
					</div>
					<div class="col-sm-6">
						<label asp-for="Sdt">Số điện thoại</label>
						<input asp-for="Sdt" class="form-control" autocomplete="tel">
						<span asp-validation-for="Sdt" class="text-danger">
						</span>
					</div>
					<div class="col-sm-6">
						<label asp-for="GioiTinh">Giới tính</label>
						<select asp-for="GioiTinh" class="form-select">
							<option>Nam</option>
							<option>Nữ</option>
							<option>Khác</option>
						</select>
					</div>
					<div class="col-12">
						<label asp-for="DiaChi">Địa chỉ</label>
<textarea asp-for="DiaChi" class="form-control" rows="2" autocomplete="street-address">
</textarea>
						<span asp-validation-for="DiaChi" class="text-danger">
						</span>
					</div>
				</div>
				<button class="btn btn-success px-4 mt-4">Lưu thay đổi</button>
			</form>
		</div>
	</div>
</div>
