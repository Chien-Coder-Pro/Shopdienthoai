@model ChangePasswordForm
@{
	ViewData["Title"] = "Đổi mật khẩu"; var u = (Nguoidung)ViewBag.CurrentUser;
}
<div class="panel narrow-panel">
	<span class="eyebrow">BẢO MẬT TÀI KHOẢN</span>
	<h1>@(u.CoMatKhau ? "Đổi mật khẩu" : "Tạo mật khẩu")</h1>
	<form asp-action="ChangePassword" method="post">
		<div asp-validation-summary="All" class="text-danger">
		</div>@if(u.CoMatKhau){
		<div class="mb-3">
			<label asp-for="MatKhauCu">Mật khẩu hiện tại</label>
			<input asp-for="MatKhauCu" class="form-control" autocomplete="current-password">
		</div>
				}
<div class="mb-3">
			<label asp-for="MatKhauMoi">Mật khẩu mới</label>
			<input asp-for="MatKhauMoi" class="form-control" autocomplete="new-password">
			<small class="form-hint">Tối thiểu 8 ký tự</small>
		</div>
		<div class="mb-4">
			<label asp-for="XacNhan">Xác nhận mật khẩu mới</label>
			<input asp-for="XacNhan" class="form-control" autocomplete="new-password">
		</div>
		<button class="btn btn-success">Cập nhật mật khẩu</button> <a asp-action="CustomerInfo" class="btn btn-light">Quay lại</a>
	</form>
</div>
